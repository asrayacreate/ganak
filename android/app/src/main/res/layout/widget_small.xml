<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: just the calendar tile and the tithi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:background="@drawable/w_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/w_band"
            android:gravity="center"
            android:maxLines="1"
            android:paddingBottom="3dp"
            android:paddingTop="3dp"
            android:text="असोज"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:text="२५"
            android:textColor="#15202A"
            android:textSize="34sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_wd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingBottom="6dp"
            android:text="आइतबार"
            android:textColor="#5B6672"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_tithi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="5dp"
        android:text="शुक्ल प्रतिपदा"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
