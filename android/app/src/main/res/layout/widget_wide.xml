<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 (and wider): calendar tile + BS year, tithi, festival, AD date -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:background="@drawable/w_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/w_band"
            android:gravity="center"
            android:maxLines="1"
            android:paddingBottom="3dp"
            android:paddingTop="3dp"
            android:text="असोज"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingTop="4dp"
            android:text="२५"
            android:textColor="#15202A"
            android:textSize="34sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_wd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingBottom="6dp"
            android:text="आइतबार"
            android:textColor="#5B6672"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="आज · वि.सं. २०८३"
            android:textColor="#F5B301"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_tithi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:text="🌙 शुक्ल प्रतिपदा"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_fest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="2dp"
            android:text="🔴 घटस्थापना"
            android:textColor="#FFB4A8"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:text="Sun, Oct 11, 2026"
            android:textColor="#AEB8C2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
